# PVS Platform Environment Variables Configuration

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-this-super-secret-key-in-production-32bytes
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database & Cache (PostgreSQL & Redis)
# -----------------------------------------------------------------------------
POSTGRES_USER=pvs_admin
POSTGRES_PASSWORD=SecretPassword123
POSTGRES_DB=pvs_db
DATABASE_URL=postgresql+asyncpg://pvs_admin:SecretPassword123@localhost:5432/pvs_db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# ASR (Speech-to-Text) Engine Configuration
# -----------------------------------------------------------------------------
ASR_ENGINE_TYPE=faster-whisper # Options: faster-whisper | whisper-cpp | google-cloud | azure-speech
WHISPER_MODEL=large-v3-turbo
ASR_HOST=http://localhost:8000

# -----------------------------------------------------------------------------
# Clinical LLM Adapter Configuration
# -----------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=typhoon # Options: typhoon | gemini | azure-openai | local-llama
TYPHOON_API_KEY=opn_live_your_typhoon_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# -----------------------------------------------------------------------------
# LINE Official Account & LIFF Configuration
# -----------------------------------------------------------------------------
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_LIFF_ID=1234567890-AbCdEfGh

# -----------------------------------------------------------------------------
# Identity & Auth (Keycloak / Auth0)
# -----------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=pvs-realm
KEYCLOAK_CLIENT_ID=pvs-web-app
