# MorBok AI (หมอบอก) — Environment Variables Example Configuration
# Copy this file to .env and replace placeholders with your actual keys.

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=your-32-character-secret-key-goes-here
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database & Cache (PostgreSQL & Redis)
# -----------------------------------------------------------------------------
POSTGRES_USER=pvs_admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=pvs_db
DATABASE_URL=postgresql+asyncpg://pvs_admin:your_postgres_password_here@localhost:5432/pvs_db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Clinical LLM Adapter Configuration (OpenRouter primary, Gemini fallback)
# -----------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_PROVIDER=google-vertex

# Gemini AI Studio (Fallback)
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Repeatable clinical summary generation. Same approved transcript is also
# cached server-side, so these values reduce variation but do not carry safety alone.
SUMMARY_GENERATION_TEMPERATURE=0.05
SUMMARY_GENERATION_SEED=42
SUMMARY_PROMPT_VERSION=grounded-clinical-summary-v1

# -----------------------------------------------------------------------------
# Speech-to-Text (ASR) Engine Configuration
# -----------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
OPENROUTER_ASR_MODEL=x-ai/grok-stt-1.0
OPENROUTER_ASR_VERIFIER_MODEL=openai/whisper-large-v3-turbo
ASR_MIN_MODEL_AGREEMENT=0.85
ASR_MIN_AGREEMENT_SOFT_ACCEPT=0.65
ASR_MIN_DICTIONARY_COVERAGE=0.4
OPENROUTER_ASR_TEMPERATURE=0
ASR_DOMAIN_PROMPT=คำแนะนำทางการแพทย์ ห้องฉุกเฉิน ประเทศไทย Metformin Amlodipine Paracetamol Cetirizine Loratadine มิลลิกรัม เม็ด รับประทาน ก่อนนอน หลังอาหาร เช้า เย็น นัดติดตามอาการ

# -----------------------------------------------------------------------------
# LINE Official Account & LIFF (Optional)
# -----------------------------------------------------------------------------
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_LIFF_ID=1234567890-AbCdEfGh

# -----------------------------------------------------------------------------
# Frontend Production API Host (Deployed Backend URL on Render)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_HOST=https://morbok-backend.onrender.com
